# Copy this file to ".env" (same folder) and fill in the real values.
# ".env" is git-ignored on purpose - never commit real keys.

# Path to your Google Earth Engine service account key file (a .json file).
# This is DIFFERENT from the Colab login you used yesterday - a service
# account key is needed so the backend server can talk to Earth Engine
# on its own, without a browser login each time.
GEE_KEY_FILE=./service-account-key.json

# Port the backend server runs on
PORT=3001
